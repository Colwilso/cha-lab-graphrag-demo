  <data key="d10">3.974e-05</data>
  <data key="d11">0.00161225</data>
</node>
<node id="Congenital Hyperinsulinism">
  <data key="d0">Congenital Hyperinsulinism</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Congenital hyperinsulinism is a condition studied retrospectively with genotype correlations in histopathology studies.&lt;SEP&gt;Congenital hyperinsulinism is a condition characterized by islet cell hypertrophy without neoplastic changes, contrasted with insulinomatosis and associated with mutations in HNF4A and ABCC8.&lt;SEP&gt;Condition associated with DNA double-strand breaks and p53 activity in beta cells.&lt;SEP&gt;Condition resulting from mutations causing glucokinase activation, leading to beta-cell replication, DSBs, p53 activation, and cell death.&lt;SEP&gt;Condition causing DNA double-strand breaks and P53 activity in beta cells.&lt;SEP&gt;Condition causing DNA double-strand breaks and p53 activity in beta cells alongside type 2 diabetes.</data>
  <data key="d3">chunk-fffe587d9d8a94d6179115102ef90a2d&lt;SEP&gt;chunk-6854465a5ab40a3dbe223209e2c5cd66&lt;SEP&gt;chunk-72bf1fbaf7a329c364247108f8b30408&lt;SEP&gt;chunk-db03a7d3c861658f2beac422f86b21ac&lt;SEP&gt;chunk-15ab370ab273e97005ced113e59cc48a&lt;SEP&gt;chunk-ce72a72ed1aaea72aac97c28374f8f86</data>
