<node id="Dynamic Perifusion Assay">
  <data key="d0">Dynamic Perifusion Assay</data>
  <data key="d1">Method</data>
  <data key="d2">Dynamic perifusion assay is an experimental method used to measure insulin secretion in both low (5.6 mM) and high (16.7 mM) glucose conditions, demonstrating increased insulin secretion in female MafAS64F/+ islets.</data>
