  <data key="d7">0</data>
  <data key="d8">beta cell / MAFA / MAFB</data>
  <data key="d9">0.00010807</data>
  <data key="d10">0.0</data>
  <data key="d11">0.01466294</data>
</node>
<node id="De Novo DNA Methylation">
  <data key="d0">De Novo DNA Methylation</data>
  <data key="d1">Method</data>
  <data key="d2">De novo DNA methylation is the epigenetic mechanism by which MafB expression is postnatally restricted in mouse β-cells.</data>
  <data key="d3">chunk-78596a38854a9e8f2c4ef9c3dfcbbfbd</data>
  <data key="d4">Examining How the MAFB Transcription Factor Affects Islet β-Cell Function Postnatally.</data>
