  <data key="d0">MDR2</data>
  <data key="d1">Gene</data>
  <data key="d2">MDR2 (Mdr2) knockout mice are a model used to study fibrosis amenable to treatment with BCL-XL inhibitors.&lt;SEP&gt;MDR2 (multidrug resistance 2 gene) knockout mice are used as a model for fibrosis research.</data>
  <data key="d3">chunk-71a6a7a3a4894dbd7d979b7e5766d5a6&lt;SEP&gt;chunk-ea13fe99fbc01cb6036ecddcda0aae8a</data>
