  <data key="d18"></data>
</edge>
<edge source="cellular senescence" target="metabolic syndrome">
  <data key="d12">1.0</data>
  <data key="d13">Accumulation of senescent cells including beta cells, hepatocytes, and preadipocytes contributes to the pathology of metabolic syndrome.</data>
