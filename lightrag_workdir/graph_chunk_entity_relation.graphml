<node id="Multiple Endocrine Neoplasia Type 1">
  <data key="d0">Multiple Endocrine Neoplasia Type 1</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Multiple Endocrine Neoplasia Type 1 is a syndrome associated with microadenomatosis of the endocrine pancreas.</data>
