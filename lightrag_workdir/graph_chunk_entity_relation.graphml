  <data key="d7">0</data>
  <data key="d8">beta cell / MAFA / MAFB</data>
  <data key="d9">0.00016227</data>
  <data key="d10">0.00035816</data>
  <data key="d11">0.00691552</data>
</node>
<node id="Serotonin Biosynthesis">
  <data key="d0">Serotonin Biosynthesis</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Serotonin biosynthesis is a biological process driven by tryptophan hydroxylase 1 that is critical for adaptive maternal β-cell responses during pregnancy.</data>
