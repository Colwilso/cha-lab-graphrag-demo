<node id="synaptic plasticity">
  <data key="d0">synaptic plasticity</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Neural transmission and plasticity are modulated by DNA breaks induced via topoisomerase and BER mechanisms in glutamatergic neurons.</data>
