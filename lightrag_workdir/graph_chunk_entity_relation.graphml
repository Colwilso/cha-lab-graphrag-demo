</node>
<node id="A0B1 Adult Mice">
  <data key="d0">A0B1 Adult Mice</data>
  <data key="d1">Organism</data>
  <data key="d2">A0B1 adult mice are MafA knockout, MafB heterozygote mice that display more severe hyperglycemia than MafA knockout (A0) adult mice alone.</data>
  <data key="d3">chunk-968f694e317648c82a07ee150e63adbd</data>
