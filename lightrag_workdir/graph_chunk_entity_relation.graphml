  <data key="d11">0.0069073</data>
</node>
<node id="Cyclin B">
  <data key="d0">Cyclin B</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Cyclin B is a cell cycle regulator that is upregulated by MafB overexpression in human β-cell lines, promoting cell proliferation.</data>
  <data key="d3">chunk-5afa9fdb0e4f653f1c7825c0b258326d</data>
  <data key="d4">MafB Is Important for Pancreatic β-Cell Maintenance under a MafA-Deficient Condition.</data>
