<node id="Diabetes Mellitus (DM)">
  <data key="d0">Diabetes Mellitus (DM)</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Diabetes mellitus (DM) is a disease characterized by impaired glucose homeostasis, encompassing both type 1 and type 2 diabetes.</data>
