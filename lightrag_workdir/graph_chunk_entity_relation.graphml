<node id="systemic inflammation">
  <data key="d0">systemic inflammation</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Systemic inflammatory response is an aging-mediated process against which GDF15 provides protection in humans and mice.</data>
  <data key="d3">chunk-71a6a7a3a4894dbd7d979b7e5766d5a6</data>
