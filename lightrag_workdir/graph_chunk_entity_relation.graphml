  <data key="d6"></data>
  <data key="d7">13</data>
  <data key="d8">SLC30A8 / RBP4 / acinar cell</data>
  <data key="d9">0.00011781</data>
  <data key="d10">0.0</data>
  <data key="d11">0.0015489</data>
</node>
<node id="C. Newgard">
  <data key="d0">C. Newgard</data>
  <data key="d1">Person</data>
  <data key="d2">C. Newgard is a researcher involved in unpublished work on Rbp4's effect on glucose-stimulated insulin secretion alongside P. Fueger.&lt;SEP&gt;C. Newgard is a researcher involved in unpublished studies showing that Rbp4 produced from rat islet cells inhibits glucose-stimulated insulin secretion.</data>
  <data key="d3">chunk-1f7f8610c162035d52f2edbe846e8a97&lt;SEP&gt;chunk-e517ac1160d78d9b935ab9b9913bf46a</data>
