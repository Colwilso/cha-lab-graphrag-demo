  <data key="d0">kidney injury</data>
  <data key="d1">Disease</data>
  <data key="d2">Kidney injury is aggravated by C/EBPα deficiency in podocytes in aging mice.</data>
  <data key="d3">chunk-71a6a7a3a4894dbd7d979b7e5766d5a6</data>
