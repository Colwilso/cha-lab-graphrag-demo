  <data key="d9">0.0001236</data>
  <data key="d10">5.77e-06</data>
  <data key="d11">0.00070304</data>
</node>
<node id="MafB+-To-MafA+ Transition">
  <data key="d0">MafB+-To-MafA+ Transition</data>
  <data key="d1">Biological Process</data>
  <data key="d2">A developmental switch in β cells from MafB expression to MafA expression that is crucial for β-cell functional maturation after birth.</data>
