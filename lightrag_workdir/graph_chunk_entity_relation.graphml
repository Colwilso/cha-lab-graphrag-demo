<node id="liver regeneration">
  <data key="d0">liver regeneration</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Liver regeneration is a biological process promoted by senescent hepatic stellate cells through IL-6 and ligands of CXCR2.</data>
  <data key="d3">chunk-71a6a7a3a4894dbd7d979b7e5766d5a6</data>
