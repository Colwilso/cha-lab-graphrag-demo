  <data key="d9">7.181e-05</data>
  <data key="d10">0.0</data>
  <data key="d11">0.00775564</data>
</node>
<node id="Mother's Milk">
  <data key="d0">Mother's Milk</data>
  <data key="d1">Tissue</data>
  <data key="d2">Mother's milk is the high-fat-based neonatal diet in laboratory rodents consumed before weaning, after which the switch to chow diet leads to higher MafA expression and metabolic changes in β-cells.</data>
  <data key="d3">chunk-f67b6052ac2da6848aaabbd71f9d4d53</data>
