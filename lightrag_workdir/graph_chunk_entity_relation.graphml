  <data key="d11">0.02414565</data>
</node>
<node id="melanocyte">
  <data key="d0">melanocyte</data>
  <data key="d1">Cell Type</data>
  <data key="d2">Senescent human melanocytes drive skin ageing via paracrine telomere dysfunction.&lt;SEP&gt;Senescent human melanocytes that drive skin aging via paracrine telomere dysfunction and mediate UVB-induced secretory inflammatory response.&lt;SEP&gt;Skin cell showing highest rate of senescence in sun-protected skin, and producing SASP including IL-6, CXCL8, CCL1, CCL2, and HMGB1 in response to UVB.</data>
  <data key="d3">chunk-ea13fe99fbc01cb6036ecddcda0aae8a&lt;SEP&gt;chunk-bf5aeca434044079720fd4ae2d32c9b9&lt;SEP&gt;chunk-7f25c34949789593e96b7a57ead73f11</data>
