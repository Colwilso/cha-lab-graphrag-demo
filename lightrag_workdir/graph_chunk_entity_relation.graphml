  <data key="d9">0.00034809</data>
  <data key="d10">0.00080291</data>
  <data key="d11">0.0042973</data>
</node>
<node id="Congenital Cataract">
  <data key="d0">Congenital Cataract</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Congenital cataract is an ocular condition observed in homozygous patient IV/5 and heterozygous subjects III/16 and III/20 from Family 1 carrying the MAFA p.Ser64Phe variant.&lt;SEP&gt;Congenital cataract is an ocular condition reported in four patients from the index family, including two homozygotes carrying the p.Ser64Phe MAFA mutation.&lt;SEP&gt;Congenital cataract is an eye disorder present in subjects IV/5 and III/16 and III/20 from family 1, observed in both homozygous and heterozygous carriers of the MAFA mutation.&lt;SEP&gt;An ocular phenotype observed in four subjects, including both homozygotes, carrying the p.Ser64Phe MAFA mutation, supported by MAFA expression in the developing lens.&lt;SEP&gt;Eye disease listed as caused by MAF transcription factor point mutations in humans.</data>
  <data key="d3">chunk-71db066aa18a18c64b2b33ad26f7bfab&lt;SEP&gt;chunk-06849490a7a3c085d30a2a392584bd67&lt;SEP&gt;chunk-348e687c811009b30863b17f466ac662&lt;SEP&gt;chunk-e531f038e6fcc1cbb89c2336af984719&lt;SEP&gt;chunk-fe670890a826e2e1970f382c46b77260</data>
