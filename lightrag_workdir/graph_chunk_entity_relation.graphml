</node>
<node id="neuronal activation">
  <data key="d0">neuronal activation</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Neuronal activation generates DSBs at specific loci including promoters of early response genes that mediate adaptive changes in synapses and memory.</data>
