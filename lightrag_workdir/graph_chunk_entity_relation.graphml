</node>
<node id="frontotemporal dementia">
  <data key="d0">frontotemporal dementia</data>
  <data key="d1">Disease</data>
  <data key="d2">Frontotemporal dementia is a neurodegenerative disease linked to GB1 release and cellular senescence.&lt;SEP&gt;Neurodegenerative disease linked to tau oligomer-induced HMGB1 release and cellular senescence.</data>
  <data key="d3">chunk-71a6a7a3a4894dbd7d979b7e5766d5a6&lt;SEP&gt;chunk-7c5a8121875c37f2659ae345688f6afe</data>
