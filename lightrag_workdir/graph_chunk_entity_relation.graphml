  <data key="d9">0.00026848</data>
  <data key="d10">0.00054243</data>
  <data key="d11">0.0012871</data>
</node>
<node id="5hmC">
  <data key="d0">5hmC</data>
  <data key="d1">Molecule</data>
  <data key="d2">5-hydroxymethylcytosine (5hmC) is enriched at SSBs and DNA repair synthesis sites in neurons and is also highly present in beta-cell genomes; postmitotic neurons have the highest levels compared with any other cell type.</data>
  <data key="d3">chunk-de697a7536ea955d878a95580bf8aa11</data>
  <data key="d4">Safeguarding genomic integrity in beta-cells: implications for beta-cell differentiation, growth, and dysfunction.</data>
