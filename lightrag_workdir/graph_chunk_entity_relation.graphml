  <data key="d11">0.00969593</data>
</node>
<node id="neuronal disorder">
  <data key="d0">neuronal disorder</data>
  <data key="d1">Disease</data>
  <data key="d2">Genetic neuronal disorders and neurodevelopmental delays result from defects in repairing topoisomerase-induced SSBs and DSBs.</data>
