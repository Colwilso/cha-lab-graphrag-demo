<node id="666–15">
  <data key="d0">666–15</data>
  <data key="d1">Method</data>
  <data key="d2">666–15 is a specific CREB inhibitor used to suppress Cdkn1a mRNA and protein expression induced by ATF6 inhibition in INS1 832/3 cells.</data>
  <data key="d3">chunk-8dfde3b4ec67624c5a1e8f788a0f0311</data>
