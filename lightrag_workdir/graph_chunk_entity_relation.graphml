  <data key="d7">102</data>
  <data key="d8">MAFA/MAFB Heterodimer</data>
  <data key="d9">0.00024291</data>
  <data key="d10">0.0</data>
  <data key="d11">0.0</data>
</node>
<node id="MafA Homodimer">
  <data key="d0">MafA Homodimer</data>
  <data key="d1">Biological Process</data>
  <data key="d2">The MafA homodimer is a protein complex found in mouse β-cells, functionally equivalent to the human MAFA/MAFB heterodimer.</data>
  <data key="d3">chunk-78596a38854a9e8f2c4ef9c3dfcbbfbd</data>
  <data key="d4">Examining How the MAFB Transcription Factor Affects Islet β-Cell Function Postnatally.</data>
  <data key="d5">1778561902</data>
  <data key="d6"></data>
