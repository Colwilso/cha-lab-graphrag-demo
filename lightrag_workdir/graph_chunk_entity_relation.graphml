  <data key="d7">22</data>
  <data key="d8">extracellular vesicles / estrogen / ZnT8</data>
  <data key="d9">0.00018559</data>
  <data key="d10">2.28e-06</data>
  <data key="d11">0.00405984</data>
</node>
