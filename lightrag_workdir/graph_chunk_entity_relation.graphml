  <data key="d9">8.216e-05</data>
  <data key="d10">0.0</data>
  <data key="d11">0.00069047</data>
</node>
<node id="Ion Flux">
  <data key="d0">Ion Flux</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Ion flux refers to the movement of ions (Ca2+, K+) across cell membranes; MafAS64F/+ islets show both sex-dependent and sex-independent changes in ion flux.</data>
  <data key="d3">chunk-df94a97c87154646f3ffd59dd4b312d0</data>
  <data key="d4">Sex-biased islet β cell dysfunction is caused by the MODY MAFA S64F variant by inducing premature aging and senescence in males.</data>
  <data key="d5">1778562655</data>
  <data key="d6"></data>
  <data key="d7">34</data>
  <data key="d8">Male MafAS64F/+ Islets / MafAS64F/+ Male Islets / Senescent Cells</data>
