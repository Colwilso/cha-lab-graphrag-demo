<node id="glomerular aging">
  <data key="d0">glomerular aging</data>
  <data key="d1">Biological Process</data>
  <data key="d2">Glomerular aging is a biological process driven by age-related GSK3β overexpression and podocyte senescence.</data>
  <data key="d3">chunk-71a6a7a3a4894dbd7d979b7e5766d5a6</data>
